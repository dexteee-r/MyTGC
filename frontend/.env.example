# Base URL of the MyTCG API.
#
# Left unset in dev: Vite proxies /api to http://127.0.0.1:8000, so the browser stays
# on one origin and there is no CORS.
#
# A Capacitor build has no proxy and loads from a native origin, so this must be an
# absolute URL that the phone itself can reach:
#   - Android emulator, backend on the host:  http://10.0.2.2:8000
#   - Physical device on the same Wi-Fi:      http://<your-lan-ip>:8000
#   - Through the Cloudflare Tunnel:          https://<your-tunnel-host>
#
# Whatever is used here must also appear in the CORS allow list in backend/app/main.py.
VITE_API_BASE=http://10.0.2.2:8000
