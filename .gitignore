# --- Data (never committed: large, regenerable, and card art is third-party copyright) ---
# The whole directory is excluded rather than known filenames, so a diagnostic dropped
# there later cannot slip into a commit. Nothing in it is source.
backend/data/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local

# --- Capacitor native builds ---
# The native projects live under frontend/, where `npx cap add` puts them.
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/ios/App/Pods/

# --- Env & editors ---
.env
.env.*
!.env.example
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# --- Local tooling config, not application code ---
# launch.json points the dev-server preview at `npm run dev`; nothing in it is
# secret, but it is machine-local tooling, not something a public repo should carry.
.claude/

# --- Frontend build output ---
frontend/dist/
frontend/node_modules/
.env.production
backend/data/*.bak

# deploy/ used to be ignored, on the reasoning that it was infrastructure for one
# host rather than application code. It is tracked now: a timer that existed only on
# the box was lost the moment anyone looked away, and nothing there changes because
# the machine changed — the Nginx policy follows the frontend's CSP, the units follow
# this repository's layout, and mytcg.env.example follows config.py.
#
# The one file that really is the machine's stays out, and always did: the real
# /etc/mytcg/mytcg.env holds the signing key and lives only on the host.
