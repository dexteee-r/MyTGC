# --- Data (never committed: large, regenerable, and card art is third-party copyright) ---
# The whole directory is excluded rather than known filenames, so a diagnostic dropped
# there later cannot slip into a commit. Nothing in it is source.
backend/data/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local

# --- Capacitor native builds ---
# The native projects live under frontend/, where `npx cap add` puts them.
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/ios/App/Pods/

# --- Env & editors ---
.env
.env.*
!.env.example
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# --- Frontend build output ---
frontend/dist/
frontend/node_modules/
.env.production
backend/data/*.bak
