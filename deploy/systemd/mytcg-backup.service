[Unit]
Description=MyTCG database backup
After=mytcg-api.service

[Service]
Type=oneshot
User=mytcg
Group=mytcg
EnvironmentFile=/etc/mytcg/mytcg.env
ExecStart=/srv/mytcg/app/deploy/scripts/backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mytcg /var/backups/mytcg
