[Unit]
Description=MyTCG API
Documentation=https://github.com/dexteee-r/MyTCG
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=mytcg
Group=mytcg
WorkingDirectory=/srv/mytcg/app

# Secrets and paths. Never commit the real file: see mytcg.env.example.
EnvironmentFile=/etc/mytcg/mytcg.env

# --proxy-headers with a loopback allow-list is what lets the API see the original
# scheme through Nginx. Without it every request looks like plain HTTP and the
# refresh cookie goes out without its Secure flag.
ExecStart=/srv/mytcg/app/.venv/bin/uvicorn \
    --app-dir backend \
    app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1 \
    --workers 1

# One worker on purpose. The hashed catalogue is held in memory per process, and a
# second worker would duplicate it for no gain on a single-household instance.

Restart=always
RestartSec=3
TimeoutStopSec=20

# --- hardening ---------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ProtectSystem=strict makes everything read-only; these two are the exceptions.
ReadWritePaths=/var/lib/mytcg

[Install]
WantedBy=multi-user.target
