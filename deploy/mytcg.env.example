# Copy to /etc/mytcg/mytcg.env, fill it in, then:
#   chown root:mytcg /etc/mytcg/mytcg.env && chmod 640 /etc/mytcg/mytcg.env
# It holds the token signing key; it must not be world-readable and must never be
# committed.

# Signs access tokens. REQUIRED.
# Without it the API generates a key at boot and every session dies on restart.
# Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MYTCG_SECRET_KEY=replace-me

# Where the database, image cache and punk-records clone live. Outside the
# checkout on purpose: 2.5 GB that must survive a redeploy.
MYTCG_DATA_DIR=/var/lib/mytcg

# Who may create an account.
#   invite  registration needs a code minted by an existing account (default)
#   open    anyone may sign up — only sane on a private network
#   closed  nobody may sign up; existing accounts keep working
#
# The instance answers on a public address, and an account is what unlocks /scan —
# the only endpoint that costs real CPU. Leave this on invite.
MYTCG_REGISTRATION=invite

# How many scans may run at once, and how long a request waits for a slot.
# Detection, deskew and three hashes on a full frame is the heaviest work here, and
# the host is a small low-power box. Raise it only if the machine is bored.
MYTCG_MAX_CONCURRENT_SCANS=2
MYTCG_SCAN_QUEUE_SECONDS=6

# Extra CORS origins, comma-separated.
# The browser app is served from the same origin as the API, so it needs nothing
# here. This exists for the Capacitor builds, whose origin is not the site's.
MYTCG_ORIGINS=capacitor://localhost,https://mytcg.elmzn.be
